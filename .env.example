# Rebrickable API v3 key — https://rebrickable.com/users/settings/#api
REBRICKABLE_API_KEY=
# Brickset API v3 key — https://brickset.com/tools/webservices/requestkey
BRICKSET_API_KEY=
# Turso (production). Leave empty to use local SQLite file (file:local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Initial login password (can be changed in the app settings)
APP_PASSWORD=
# Random 32+ byte hex string used to sign session cookies
SESSION_SECRET=
# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: stop catalog import when DB size exceeds this many bytes (default 4.5 GB)
STORAGE_LIMIT_BYTES=
# Passphrase used to encrypt the weekly GitHub Actions backup artifact
BACKUP_PASSPHRASE=
